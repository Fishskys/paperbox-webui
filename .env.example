# 复制为 .env 并填入真实值
PAPERBOX_API_BASE=http://127.0.0.1:8077
PAPERBOX_API_KEY=change-me
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8088
REQUEST_TIMEOUT=30

# 上传队列（通过 GET /api/ui/config 下发给浏览器，前端不硬编码）
# 并发数不要超过 paperbox 的 INGEST_UPLOAD_CONCURRENCY（同为 2），否则只会吃 429
WEBUI_UPLOAD_CONCURRENCY=2
WEBUI_UPLOAD_MAX_ATTEMPTS=6
WEBUI_RETRY_BASE_MS=2000
WEBUI_RETRY_CAP_MS=60000
WEBUI_FILE_MAX_MB=100
WEBUI_BATCH_HINT_THRESHOLD=20
