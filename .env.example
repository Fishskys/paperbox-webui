# 复制为 .env 并填入真实值
# 时区（2026-10-10）：与 paperbox 同口径，全栈统一 Asia/Shanghai（代码里 `TZ` 可覆盖）。
TZ=Asia/Shanghai
PAPERBOX_API_BASE=http://127.0.0.1:8077
# 必须是 paperbox 侧签发的 key（role=admin：本 WebUI 代理了删除等写操作）。
# 签发：在 paperbox 目录执行 `uv run python scripts/manage_keys.py create --prefix webui --role admin`
# 密钥只写在本文件（.env 已在 .gitignore 第 1 行，绝不入 git）；下面的占位值仅用于说明格式。
PAPERBOX_API_KEY=pb_webui_<32位十六进制>_占位值
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8088
REQUEST_TIMEOUT=30

# 上传队列（通过 GET /api/ui/config 下发给浏览器，前端不硬编码）
# 并发数不要超过 paperbox 的 INGEST_UPLOAD_CONCURRENCY（同为 2），否则只会吃 429
WEBUI_UPLOAD_CONCURRENCY=2
WEBUI_UPLOAD_MAX_ATTEMPTS=6
WEBUI_RETRY_BASE_MS=2000
WEBUI_RETRY_CAP_MS=60000
WEBUI_FILE_MAX_MB=100
WEBUI_BATCH_HINT_THRESHOLD=20
